<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/source/ChannelStore.brs" />
    <interface>
        <field id="channels" type="array" onChange="onChannelsChange" />
        <field id="providerMode" type="boolean" />
        <field id="accountConfig" type="assocarray" />
        <field id="playRequest" type="assocarray" />
        <field id="exitRequested" type="boolean" />
    </interface>

    <children>
        <Label id="titleLabel"
               translation="[96, 46]"
               width="1728" height="42"
               text="SEARCH CHANNELS"
               color="0xECF2EEFF"
               font="font:MediumBoldSystemFont" />

        <!-- A one-row LabelList provides the same green focus treatment as the rest
             of the app. The stock Button painted a large white bar here. -->
        <LabelList id="searchButton"
                   translation="[96, 102]"
                   itemSize="[1728, 64]"
                   itemSpacing="[0, 0]"
                   numRows="1"
                   color="0xECF2EEFF"
                   focusedColor="0x08130AFF"
                   focusBitmapBlendColor="0x5FD345FF" />

        <Label id="headerLabel"
               translation="[96, 184]"
               color="0xECF2EEFF"
               width="1728"
               height="40" />
               
        <Label translation="[168, 226]" width="720" height="24"
               text="CHANNEL" color="0x8A968EFF"
               font="font:SmallestBoldSystemFont" />
        <Label translation="[964, 226]" width="760" height="24"
               text="NOW / NEXT" color="0x8A968EFF"
               font="font:SmallestBoldSystemFont" />
        <MarkupList id="channelGrid"
                    translation="[96, 256]"
                    itemComponentName="ChannelRow"
                    itemSize="[1728, 64]"
                    itemSpacing="[0, 6]"
                    numRows="10"
                    focusBitmapBlendColor="0x57C140FF" />
                    
        <Label id="statusLabel"
               translation="[96, 480]"
               width="1728"
               horizAlign="center"
               color="0x8A968EFF"
               text="Type at least 2 characters" />
               
        <!-- Toast -->
        <!-- 920, matching ChannelsScreen. At 950 the 60px-high toast ended at 1010,
             70px from the panel edge against a 90px advisory margin - the same defect
             T1-6 fixed on the other screen and did not sweep for here. -->
        <Rectangle id="toastBg"
                   translation="[460, 920]"
                   width="1000"
                   height="60"
                   color="0x18211CFF"
                   visible="false">
            <Label id="toastLabel"
                   width="1000"
                   height="60"
                   horizAlign="center"
                   vertAlign="center"
                   color="0xECF2EEFF" />
        </Rectangle>
        
        <Timer id="toastTimer" duration="2.5" repeat="false" />
    </children>
</component>
